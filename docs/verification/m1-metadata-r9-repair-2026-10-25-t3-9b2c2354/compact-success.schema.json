{
  "$id": "openergy.metadata-success.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed success stdout shape only. Raw canonical JSON including newline MUST be at most512 bytes; schema alone cannot express that byte predicate. Parent MUST verify exact root/path, bytes/hash, full v2 result and every raw/status/comparison, actual caller0/complete EOF and all shared deadlines. No acceptance or execution authority. Parent v2 bounds and arithmetic also apply unchanged.",
  "oneOf": [
    {
      "properties": {
        "mode": {
          "const": "source"
        },
        "result": {
          "properties": {
            "path": {
              "pattern": "^/Users/m1-dev/\\.local/state/openergy-verification/m1-ordinary-reviewed-flow-20261025-[^/]+/metadata-source-result\\.json$"
            }
          }
        }
      }
    },
    {
      "properties": {
        "mode": {
          "const": "copy"
        },
        "result": {
          "properties": {
            "path": {
              "pattern": "^/Users/m1-dev/\\.local/state/openergy-verification/m1-ordinary-reviewed-flow-20261025-[^/]+/metadata-copy-result\\.json$"
            }
          }
        }
      }
    }
  ],
  "properties": {
    "mode": {
      "enum": [
        "source",
        "copy"
      ]
    },
    "phase_deadline_ns": {
      "maximum": 100000000119999999999,
      "minimum": 120000000000,
      "type": "integer"
    },
    "phase_started_ns": {
      "maximum": 99999999999999999999,
      "minimum": 0,
      "type": "integer"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 8388608,
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "type": "object"
    },
    "schema": {
      "const": "openergy.metadata-success.v1"
    }
  },
  "required": [
    "schema",
    "mode",
    "phase_started_ns",
    "phase_deadline_ns",
    "result"
  ],
  "type": "object"
}
