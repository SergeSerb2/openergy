{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future NEW Windows baseline run result; no runtime result exists in this package",
  "type": "object",
  "required": [
    "schema",
    "execution",
    "execution_scope",
    "historical_preservation",
    "historical_runtime_status",
    "historical_results_changed",
    "historical_fixture_bindings_qualified",
    "historical_fixture_bindings_required",
    "original_stop_requests",
    "source_commit",
    "passed",
    "compiler_stage_attempts",
    "runtime_stage_attempts",
    "fresh_selected_preservation",
    "fresh_root_cleanup",
    "controller_exit"
  ],
  "properties": {
    "schema": {
      "const": "openergy.windows-fresh-baseline-result.v1"
    },
    "execution": {
      "const": true
    },
    "execution_scope": {
      "const": "NEW_FRESH_BASELINE_BUILD_AND_FLOW"
    },
    "historical_preservation": {
      "const": "UNVERIFIED"
    },
    "historical_runtime_status": {
      "const": "FAILED_UNVERIFIED"
    },
    "historical_results_changed": {
      "const": false
    },
    "historical_fixture_bindings_qualified": {
      "const": 0
    },
    "historical_fixture_bindings_required": {
      "const": 9
    },
    "original_stop_requests": {
      "const": 0
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "passed": {
      "type": "boolean"
    },
    "compiler_stage_attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "runtime_stage_attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "fresh_selected_preservation": {
      "enum": [
        "UNVERIFIED",
        "VERIFIED_FOR_THIS_NEW_RUN_ONLY"
      ]
    },
    "fresh_root_cleanup": {
      "enum": [
        "NO_REMOTE_ROOT_CREATED",
        "UNVERIFIED_SETUP_RESPONSE_OR_OWNERSHIP",
        "SETUP_FAILURE_OWNED_ROOT_REMOVED",
        "PENDING_OWNED_SETTLEMENT_AND_COLLECTION",
        "UNVERIFIED_AFTER_COLLECTION_OR_REMOVAL_FAILURE",
        "VERIFIED_ONLY_THIS_NEW_ROOT"
      ]
    },
    "controller_exit": {
      "enum": [
        0,
        1
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "passed": {
            "const": true
          }
        },
        "required": [
          "passed"
        ]
      },
      "then": {
        "required": [
          "qualification_exit",
          "build_exit",
          "runtime_exit",
          "postflight_exit",
          "cleanup_exit",
          "cleanup",
          "local_prior_evidence_equal"
        ],
        "properties": {
          "controller_exit": {
            "const": 0
          },
          "compiler_stage_attempts": {
            "const": 1
          },
          "runtime_stage_attempts": {
            "const": 1
          },
          "qualification_exit": {
            "const": 0
          },
          "build_exit": {
            "const": 0
          },
          "runtime_exit": {
            "const": 0
          },
          "postflight_exit": {
            "const": 0
          },
          "cleanup_exit": {
            "const": 0
          },
          "fresh_selected_preservation": {
            "const": "VERIFIED_FOR_THIS_NEW_RUN_ONLY"
          },
          "fresh_root_cleanup": {
            "const": "VERIFIED_ONLY_THIS_NEW_ROOT"
          },
          "local_prior_evidence_equal": {
            "const": true
          },
          "cleanup": {
            "type": "object",
            "required": [
              "owned_root_removed"
            ],
            "properties": {
              "owned_root_removed": {
                "const": true
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "controller_exit": {
            "const": 1
          }
        }
      }
    }
  ],
  "additionalProperties": true,
  "$comment": "Schema data only. No schema evaluator, supplied code, mock run or runtime result was used. Before/after/postflight/state also carry explicit NEW scope and historical preservation UNVERIFIED."
}
