+                  'r': value['r'], 'c': [0] * 9, 'n': 9, 'reaped': 511, 'eof': 511,
+                  'kill': 0, 'loss': 0, 'p': [2, 2, 2, 2],
+                  'raws_unpublished': False, 'f': None})
+    return value
