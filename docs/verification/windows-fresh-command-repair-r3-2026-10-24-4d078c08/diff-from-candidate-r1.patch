+  if($null -ne $transportResource){try{$transportResource.Dispose()}catch{if($null -eq $transportFirstError){$transportFirstError=$_}}}
+ }
+}
+if($null -ne $transportFirstError){throw $transportFirstError}
+& ([ScriptBlock]::Create($transportText))
+'''.replace('__LITERAL__',literal).replace('__BYTES__',str(len(data))).replace('__HASH__',sha(data))
