+def sequence():
+    helper = [SYSTEM, '-I', '-S', '-B', ROOT + '/file-qualification.recipe.py.txt', ROOT, 'source']
+    return ([dict(label='source-files-before', argv=helper, environment=startup())]
+            + [dict(label=row['label'], argv=row['argv'], environment=native_environment(ROOT))
+               for row in REQUIREMENTS]
