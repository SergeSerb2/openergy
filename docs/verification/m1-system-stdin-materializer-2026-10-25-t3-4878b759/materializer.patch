+    require(len(receipt_data) <= RECEIPT_CAP, 'full receipt cap')
+    receipt_ref = put(rootfd, device, RECEIPT, receipt_data, budget)
+    call(os.close, rootfd)
+    STAGE = 'compact-console'
+    emit_once(receipt_ref, refs)
+    check()
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except BaseException as exc:
+        # First failure latched before any possible later publication. There is
+        # no failure publisher, repair, finally-write, close/flush or new work.
+        if FIRST_ERROR is None:
+            FIRST_ERROR = dict(stage=STAGE, error=type(exc).__name__)
+        os._exit(1)
+    os._exit(0)  # Actual exit/EOF/deadline acceptance remains with the parent.
