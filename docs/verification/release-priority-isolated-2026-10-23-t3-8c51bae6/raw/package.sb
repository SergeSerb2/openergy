(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath "/private/tmp/oe-priority-isolated-t3-8c51bae6-nfye7e16") (literal "/dev/null")
 (regex #"^/private/tmp/oe-(package|release-smoke)-[A-Za-z0-9_]+(/|$)"))
(deny network*)
(allow network* (local ip "localhost:65420") (remote ip "localhost:65420")
 (local unix-socket (regex #"^/private/tmp/oe-release-smoke-[A-Za-z0-9_]+/control[.]sock$"))
 (remote unix-socket (regex #"^/private/tmp/oe-release-smoke-[A-Za-z0-9_]+/control[.]sock$")))
