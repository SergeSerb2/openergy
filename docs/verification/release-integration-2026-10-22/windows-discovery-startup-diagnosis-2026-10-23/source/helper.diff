+// Diagnostic-only caller observations and existing log::Log records.
+// No worker instrumentation, injected command, wait, or acceptance change.
+static DIAG_CLOCK: std::sync::OnceLock<Instant> = std::sync::OnceLock::new();
+struct StartupTrace;
+static STARTUP_TRACE: StartupTrace = StartupTrace;
+fn diag_mark(message: impl std::fmt::Display) {
+    let elapsed = DIAG_CLOCK.get_or_init(Instant::now).elapsed().as_nanos();
+    eprintln!("[DEBUG-oe-startup] at_ns={elapsed} thread={:?} {message}", thread::current().id());
+}
+impl log::Log for StartupTrace {
+    fn enabled(&self, metadata: &log::Metadata<'_>) -> bool {
+        metadata.target() == "mdns_sd::service_daemon"
+    }
+    fn log(&self, record: &log::Record<'_>) {
+        if !self.enabled(record.metadata()) { return; }
+        // Exact frozen-source sites: command entry, initial-send failure.
+        if record.line() != Some(4058) && record.line() != Some(4232) { return; }
+        let message = record.args().to_string();
+        if message.contains(GUARD_TYPE) || message.contains("_oe-c") {
+            diag_mark(format_args!("LIB line={} level={} {message}", record.line().unwrap_or(0), record.level()));
+        }
+    }
+    fn flush(&self) {}
+}
+fn diag_logger() {
+    DIAG_CLOCK.get_or_init(Instant::now);
+    log::set_logger(&STARTUP_TRACE).expect("diagnostic logger");
+    log::set_max_level(log::LevelFilter::Trace);
+}
