+def remove_cache(p, before):
+    # Bounded inventory is unchanged. Check between destructive steps, not just before rmtree.
+    names = sorted(before['inventory'], key=lambda n: (-len(Path(n).parts), n)) + [None]
+    for name in names:
+        with LEDGER.lock:
+            require_cache_quiet()
+            current = p.lstat()
+            require((current.st_dev, current.st_ino) == (before['device'], before['inode']) and
+                    current.st_uid == UID and stat.S_ISDIR(current.st_mode) and p.resolve() == p, 'cache identity changed')
+            fds = []
+            try:
+                # Relative directory descriptors never follow a substituted interior symlink.
+                fd = os.open(p.parent if name is None else p, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+                fds.append(fd)
+                parts = (p.name,) if name is None else Path(name).parts
+                if name is not None:
+                    root_state = os.fstat(fd)
+                    require((root_state.st_dev, root_state.st_ino) == (before['device'], before['inode']), 'opened cache changed')
+                for part in parts[:-1]:
+                    fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
+                    fds.append(fd)
+                    require(os.fstat(fd).st_uid == UID, 'cache parent ownership changed')
+                state = os.stat(parts[-1], dir_fd=fd, follow_symlinks=False)
