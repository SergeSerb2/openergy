+                    os.unlink(parts[-1], dir_fd=fd)
+            finally:
+                for fd in reversed(fds):
+                    os.close(fd)
+    with LEDGER.lock:
+        require_cache_quiet()
+    require(not p.exists(), 'cache removal incomplete')
 
 
