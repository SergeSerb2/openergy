+/// A coalesced view of at most 64 resolved services, updated on the daemon worker.
+/// Existing selected services keep their slots until removal. Unselected services
+/// do not displace them. This bounds delivery state, not the daemon's DNS cache.
+pub struct LimitedBrowse {
+    // The standard subscription channel supplies identity and lifetime only.
+    // Its single SearchStarted event is never used for state delivery.
+    lifetime: Receiver<ServiceEvent>,
+    state: Arc<Mutex<LimitedServiceState>>,
+}
+
+#[derive(Debug)]
+struct LimitedServiceState {
+    limit: usize,
+    dirty: bool,
+    services: BTreeMap<String, ResolvedService>,
+}
+
+impl LimitedBrowse {
+    /// Returns the latest complete selected view after a change. Intermediate
+    /// updates coalesce; removals are represented by absence in the next view.
+    /// A caller must replace its prior view, rather than merge snapshots.
+    pub fn take_snapshot(&self) -> Option<Vec<ResolvedService>> {
+        let mut state = self.state.lock().unwrap_or_else(|e| e.into_inner());
+        if !state.dirty {
+            return None;
+        }
+        let snapshot = state.services.values().cloned().collect();
+        state.dirty = false;
+        Some(snapshot)
+    }
+
+    /// A closed view must be discarded; it can no longer report removals.
+    pub fn is_closed(&self) -> bool {
+        self.lifetime.is_disconnected()
+    }
+}
 
